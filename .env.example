# CardGuard AI Environment Configuration

# GCP Project Settings
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=True

# Gemini / Model Settings
GEMINI_MODEL_FAST=gemini-3.8-flash
GEMINI_MODEL_REASONING=gemini-3.8-pro
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_API_KEY=placeholder-for-local-ai-studio-dev

# Storage & Database Settings
GCS_BUCKET_NAME=cardguard-knowledge-dev
BIGQUERY_DATASET=cardguard_fraud_db
PUBSUB_TOPIC_TRANSACTIONS=cardguard-transactions-dev
PUBSUB_SUBSCRIPTION_TRANSACTIONS=cardguard-transactions-sub-dev

# Security & Auth Settings
SECRET_MANAGER_PREFIX=projects/your-gcp-project-id/secrets
MCP_AUTH_TOKEN_SECRET=mcp-auth-token-dev
API_KEY_SECRET=api-key-dev

# Server & Service Settings
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
ENABLE_TRACE=true

# Agent Runtime / A2A Settings
A2A_HOST=0.0.0.0
A2A_PORT=8001
MCP_HOST=0.0.0.0
MCP_PORT=8002
